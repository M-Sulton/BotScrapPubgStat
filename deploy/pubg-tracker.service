[Unit]
Description=PUBG Steam Stats Tracker & Discord Banter Bot
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/BotScrapPubgStat
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=10
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=pubg-bot
Environment=NODE_ENV=production
Environment=PORT=3000

[Install]
WantedBy=multi-user.target
